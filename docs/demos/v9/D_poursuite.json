        "title": "Poursuite Roblox — PathfindingService, waypoints et chemins bloqués",
        "steps": [
          {
            "text": "Créer un Path avec les paramètres du gabarit du PNJ, puis calculer le chemin avec ComputeAsync sous gestion d’erreur.",
            "source_note": "vdn-939f03f673d6",
            "source_urls": [
              "https://create.roblox.com/docs/characters/pathfinding"
            ],
            "verified": false,
            "origin": "source_based_editorial_candidate"
          },
          {
            "text": "Vérifier PathStatus.Success avant de parcourir les waypoints retournés dans leur ordre.",
            "source_note": "vdn-939f03f673d6",
            "source_urls": [
              "https://create.roblox.com/docs/characters/pathfinding"
            ],
            "verified": false,
